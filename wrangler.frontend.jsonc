{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "file-transfer",
  // Match the workerd version pinned by the repository's lockfile.
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "file.thanejoss.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
